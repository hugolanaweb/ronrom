---
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Button from './Button.astro';
import { site, whatsappUrl } from '../data/site';

interface Props {
  title: string;
  description: string;
  updated?: Date;
  cover?: ImageMetadata;
  coverAlt?: string;
}
const { title, description, updated, cover, coverAlt } = Astro.props;

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'pt-BR',
  ...(updated ? { dateModified: updated.toISOString() } : {}),
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: new URL(Astro.url.pathname, site.url).href,
};
---

<Base title={title} description={description} type="article" schema={[article]}>
  <PageHero eyebrow="Guia" title={title} note="Sem jargão" image={cover} imageAlt={coverAlt ?? ''} imagePosition="46% 50%">
    <p>{description}</p>
    <p class="notice" role="note">
      Conteúdo em revisão: este guia deve ser revisado por um(a) médico(a)-veterinário(a) antes de publicado.
    </p>
    <Fragment slot="actions">
      <Button href="/guias" variant="text">← Todos os guias</Button>
    </Fragment>
  </PageHero>

  <section class="section section--areia guide-body" aria-label="Conteúdo do guia">
    <div class="container">
      <article class="prose surface reveal">
        <slot />
      </article>
    </div>
  </section>

  <section class="section section--creme" aria-labelledby="guide-cta-title">
    <div class="container reveal guide-cta">
      <div class="section-head">
        <p class="eyebrow">Ficou com dúvida?</p>
        <h2 id="guide-cta-title">Precisa de ajuda com isso?</h2>
        <p class="lead">Conte com a gente. Marque uma consulta e a gente conversa sobre o seu gato, no ritmo dele.</p>
      </div>
      <div class="guide-cta__actions">
        <Button href="/agendar">Agendar consulta</Button>
        <Button href={whatsappUrl()} variant="outline" external>Falar pelo WhatsApp</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .notice {
    display: inline-block;
    margin-top: var(--s-4);
    padding: var(--s-2) var(--s-4);
    border-radius: var(--r-md);
    background: var(--areia);
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .guide-body :global(.prose) { max-width: 780px; margin-inline: auto; padding: var(--s-7); }
  .guide-body :global(.prose blockquote) {
    margin: 0 0 var(--s-6);
    padding: var(--s-4) var(--s-5);
    border-left: 4px solid var(--terracota);
    background: var(--creme);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
  }
  .guide-body :global(.prose blockquote p) { margin: 0; }
  .guide-body :global(.prose h2:first-of-type) { margin-top: 0; }
  .guide-cta__actions { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-4); }
</style>
