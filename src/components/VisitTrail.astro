---
import { visitSteps, visitStepIcons } from '../data/site';
import CatMark from './CatMark.astro';
import Icon from './Icon.astro';
---

<div class="trail" data-trail>
  <div class="trail__track" aria-hidden="true">
    <div class="trail__line"><div class="trail__fill"></div></div>
    <div class="trail__cat"><CatMark size={40} /></div>
  </div>
  <ol class="trail__steps">
    {
      visitSteps.map((step, i) => (
        <li class="step" data-step>
          <div class="step__top">
            <span class="step__dot" aria-hidden="true">{i + 1}</span>
            <span class="step__icon"><Icon name={visitStepIcons[step.id]} size={30} /></span>
          </div>
          <h3>{step.title}</h3>
          <p>{step.short}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .trail { --p: 0; position: relative; }
  .trail__steps { list-style: none; display: grid; gap: var(--s-6); position: relative; }
  .step { position: relative; display: grid; grid-template-columns: auto 1fr; column-gap: var(--s-4); align-items: start; }
  .step__top { grid-row: 1 / 3; display: flex; flex-direction: column; align-items: center; gap: var(--s-3); }
  .step h3 { font-size: 1.375rem; margin: 0 0 var(--s-1); }
  .step p { margin: 0; color: var(--text-muted); font-size: 0.9375rem; }
  .step__icon { color: var(--terracota); }
  .step__dot {
    width: 40px; height: 40px;
    display: grid; place-items: center;
    border-radius: 50%;
    border: 2px solid var(--salvia-profunda);
    background: var(--creme);
    color: var(--salvia-profunda);
    font-weight: 600;
    z-index: 1;
    transition: background-color var(--t-base) var(--ease), color var(--t-base) var(--ease);
  }
  .step.is-reached .step__dot { background: var(--salvia-profunda); color: var(--branco); }

  /* Celular: lista vertical, sem símbolo deslizante. */
  .trail__track { display: none; }

  @media (min-width: 1024px) {
    .trail__track { display: block; position: relative; height: 56px; margin-bottom: var(--s-4); }
    .trail__line {
      position: absolute; left: 0; right: 0; top: 50%;
      height: 2px; border-radius: 2px;
      background: repeating-linear-gradient(90deg, #cdbfa8 0 6px, transparent 6px 12px);
      transform: translateY(-50%);
    }
    .trail__fill {
      height: 100%; border-radius: inherit;
      background: var(--salvia-profunda);
      width: calc(var(--p) * 100%);
    }
    .trail__cat {
      position: absolute;
      top: 50%;
      left: calc(var(--p) * 100%);
      transform: translate(-50%, -50%);
      color: var(--terracota);
      background: var(--creme);
      border-radius: 50%;
      padding: 4px;
    }
    .trail__steps { grid-template-columns: repeat(5, 1fr); gap: var(--s-6); }
    .step { display: block; }
    .step__top { flex-direction: row; justify-content: flex-start; gap: var(--s-3); margin-bottom: var(--s-4); }
    .step p { max-width: 24ch; }
  }
  /* Sem JS e com movimento reduzido: trilha completa e estática. */
  :global(html:not(.js)) .trail { --p: 1; }
  :global(html:not(.js)) .step__dot { background: var(--salvia-profunda); color: var(--branco); }
  @media (prefers-reduced-motion: reduce) {
    .trail__cat, .trail__fill { transition: none; }
  }
</style>

<script>
  const trail = document.querySelector<HTMLElement>('[data-trail]');
  if (trail) {
    const steps = Array.from(trail.querySelectorAll<HTMLElement>('[data-step]'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wide = window.matchMedia('(min-width: 1024px)');
    const update = () => {
      const vh = window.innerHeight;
      if (reduced) {
        trail.style.setProperty('--p', '1');
        steps.forEach((s) => s.classList.add('is-reached'));
        return;
      }
      if (wide.matches) {
        // Passos lado a lado: a linha avança enquanto o topo da trilha sobe de 90% a 5% da tela,
        // então só fica cheia depois que a pessoa já passou pelos passos.
        const r = trail.getBoundingClientRect();
        const start = vh * 0.9;
        const end = vh * 0.05;
        const p = Math.min(1, Math.max(0, (start - r.top) / (start - end)));
        trail.style.setProperty('--p', p.toFixed(3));
        steps.forEach((s, i) => s.classList.toggle('is-reached', p >= i / steps.length + 0.02));
      } else {
        // Lista vertical: cada passo acende quando chega perto do meio da tela.
        steps.forEach((s) => s.classList.toggle('is-reached', s.getBoundingClientRect().top < vh * 0.65));
      }
    };
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    wide.addEventListener('change', onScroll);
  }
</script>
